<mujoco model="shadow_cup_scene">
  <!--
    Shadow right hand + table + cup + coaster.

    This file must sit INSIDE mujoco_menagerie/shadow_hand/ so that the mesh
    paths inside right_hand.xml resolve. scripts/build_scene.py copies it there.

    TUNE THESE after you first open it (positions are a starting guess):
      - the hand's height/orientation above the table
      - cup radius/height to match your real cup
      - coaster position to match your measured real-world layout
    Open it with mujoco.viewer pointed at
    mujoco_menagerie/shadow_hand/scene_cup.xml (build_scene.py prints the command).
  -->

  <include file="right_hand.xml"/>

  <statistic center="0 0 0.2" extent="0.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="130" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texrepeat="5 5" reflectance="0.1"/>
    <material name="table_mat" rgba="0.75 0.68 0.58 1"/>
    <material name="cup_mat" rgba="0.85 0.25 0.2 1"/>
    <material name="coaster_mat" rgba="0.15 0.5 0.75 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- table top at z = 0.30 -->
    <body name="table" pos="0 0 0.15">
      <geom name="table_top" type="box" size="0.40 0.30 0.015" pos="0 0 0.135"
            material="table_mat" friction="1.0 0.01 0.001"/>
      <geom name="table_leg" type="box" size="0.05 0.05 0.135" pos="0 0 0"
            material="table_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- coaster: static target, place where you measured it in the real setup -->
    <body name="coaster" pos="0.12 -0.14 0.304">
      <geom name="coaster_geom" type="cylinder" size="0.045 0.004"
            material="coaster_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- cup: free body, starting pose overwritten per episode by replay -->
    <body name="cup" pos="0.0 0.10 0.345">
      <freejoint name="cup_free"/>
      <inertial pos="0 0 0" mass="0.12" diaginertia="0.00012 0.00012 0.00008"/>
      <geom name="cup_geom" type="cylinder" size="0.035 0.045"
            material="cup_mat" friction="1.2 0.02 0.001"
            solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>
</mujoco>
